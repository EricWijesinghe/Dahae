# One domain for everything, HTTPS certificates issued and renewed automatically:
#   https://DOMAIN/          website
#   https://DOMAIN/app/      customer web app (PWA; every /app/* deep link serves index.html)
#   https://DOMAIN/admin/    operations console (setup wizard on first visit)
#   https://DOMAIN/v1, /health   API (uploads: /v1/files, signed URLs only)
#   https://DOMAIN/.well-known/assetlinks.json, apple-app-site-association   App Links, served by the API from env
#   https://www.DOMAIN/*     permanent redirect to https://DOMAIN/* (needs a www DNS record; harmless without one)
#   https://DOMAIN/auth/naver/callback   Naver login: the app takes this URL (App Link); the page is only the browser fallback
#   https://OLD/*            a former domain after a console domain change: everything is served as on DOMAIN (installed
#                            apps keep working), only website pages get a 302 to DOMAIN. The API decides which hosts
#                            (crates/api/src/domains.rs); nothing about them is in compose or .env.
{
	# Quoted: an empty ACME_EMAIL (the installer allows it) is then one empty argument, not a parse error.
	email "{$ACME_EMAIL}"
	# Certificates for former domains are fetched on the first visit, only for hosts the API answers 200 for.
	on_demand_tls {
		ask http://api:8080/internal/tls-ask
	}
}

# TLS_MODE picks one of these (`import tls-{$TLS_MODE}`): empty = automatic public HTTPS, internal = Caddy's
# own CA (installer tests only). A bare `tls {$TLS_MODE}` fails to parse when TLS_MODE is empty.
(tls-) {
}
(tls-internal) {
	tls internal
}
# The same choice for former domains, with certificates on demand.
(alias-tls-) {
	tls {
		on_demand
	}
}
(alias-tls-internal) {
	tls internal {
		on_demand
	}
}

# Response headers for every answer. Error pages (handle_errors) do not pass through the site's own header
# directive, so they import these again.
(edge-headers) {
	# Deferred (it deletes a field), so these are set when the response is written, over anything upstream sent.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		# No camera, microphone or USB for any page; location only for our own pages (address search).
		Permissions-Policy "camera=(), microphone=(), usb=(), geolocation=(self), browsing-topics=()"
		# Our pages keep their opener links to the PG payment popups they open, nothing else does.
		Cross-Origin-Opener-Policy same-origin-allow-popups
		-Server
	}
}

# Everything the main domain serves. Imported by the main site and by the former-domain site below.
(site) {
	encode zstd gzip

	# JSON access log in the caddylogs volume: 10 MB per file, 14 files kept, 3 months at most (the retention rule in docs/privacy-retention.md). Every query string is
	# dropped before anything is written (admin lookups carry phone numbers, names and addresses, and secrets such as
	# the websocket ticket or signed links), and the ops-progress path's token too. One regexp covers both.
	# Credential headers (bearer token, cookies, the owner's authenticator code) and Referer (a page URL with its
	# query) are never written.
	# shortcut: no edge rate limit on /v1/auth/*, the stock caddy image has no rate_limit module; add one (custom
	#   image via xcaddy with mholt/caddy-ratelimit) or keep the app-level buckets (ratelimit.rs), when the edge needs it.
	log {
		output file /var/log/caddy/access.log {
			roll_size 10mb
			roll_keep 14
			roll_keep_for 2160h
		}
		format filter {
			wrap json
			fields {
				request>headers>Authorization delete
				request>headers>Cookie delete
				request>headers>X-Owner-Totp delete
				request>headers>Referer delete
				request>uri regexp "(ops-progress/|[?]).*" "${1}REDACTED"
			}
		}
	}

	import edge-headers

	# Two CSPs, chosen by path (the matchers are exact opposites, so exactly one applies).
	# Apps, payment pages and API-rendered pages get the policy below; the static website gets the strict
	# one after it.
	@app_csp path /v1/* /health /.well-known/* /c/* /sitemap.xml /robots.txt /notices.xml /webfonts/* /admin /admin/* /app /app/* /pay /pay/*
	@site_csp not path /v1/* /health /.well-known/* /c/* /sitemap.xml /robots.txt /notices.xml /webfonts/* /admin /admin/* /app /app/* /pay /pay/*
	# Every API, websocket and PWA call is same-origin ('self' also covers ws/wss).
	# script-src: 'unsafe-inline' for the payment pages (website/pay/) and Flutter's
	#   bootstrap (no hashes: Flutter rewrites its bootstrap per build). cdn.portone.io = PortOne V2 browser SDK
	#   (website/pay/index.html); js.tosspayments.com = Toss Payments V2 SDK (website/pay/toss*.html).
	#   No 'unsafe-eval': both web builds are compiled with --wasm (skwasm).
	# wasm-unsafe-eval: WebAssembly compile for skwasm/CanvasKit (self-hosted, --no-web-resources-cdn).
	# style-src / font-src: same origin only (the website self-hosts its Dahae Sans subset). No Google Fonts:
	#   the Flutter apps load their fallback fonts from /webfonts/ (same origin).
	# connect-src: *.portone.io = PortOne API (api.portone.io) and SDK calls; *.tosspayments.com = Toss Payments
	#   SDK calls (the window and billing pages). blob: = a picked image (logo, photo): the web image picker hands
	#   the file over as a blob: URL and Flutter reads it with a fetch, which 'self' does not cover. Social sign-in (Kakao, Naver,
	#   Google, Apple) runs in the native apps only; the web build offers no social SDK, so no hosts here.
	# frame-src / form-action: PG payment windows (card, KakaoPay, NaverPay...) are hosted by many PGs whose
	#   hosts PortOne and Toss do not publish as a fixed list; keep https: or checkout breaks.
	# frame-ancestors none: nothing may embed us.
	header @app_csp Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://cdn.portone.io https://js.tosspayments.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: https:; connect-src 'self' blob: https://*.portone.io https://*.tosspayments.com; frame-src 'self' https:; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self' https:; frame-ancestors 'none'"
	# Static website: no inline script except the theme snippet in its pages' <head>, allowed by hash
	# (scripts/ci/check-native.py fails when a page's inline script has no hash here). No PG, no frames.
	header @site_csp Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-BAOxqSXTXY0xct7XpdRWh4Q+kVwbxikbI09LZ/Tqsqg=' 'sha256-UtC0U60paHl4CC9DOzN7OY+bZaNnUQ9p4kyLhFax6ts='; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: https:; connect-src 'self'; frame-src 'none'; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"

	# Probes, metrics and the certificate question are for the server itself, never the internet; nor are the
	# website's own tests (website/tests/), which ship inside /srv/website.
	# A handle block, not a bare respond: handle runs before respond, so the catch-all handle below would answer first.
	@internal path /ready /metrics /internal/* /tests/*
	handle @internal {
		respond 404
	}

	# The domain root approved (DOMAIN in the root-written .env). The apps check it before following a new
	# api_base from /v1/config, because a hijacked API could name any host there (api_base_discovery.dart).
	handle /.well-known/dahae-domain {
		header Cache-Control "no-store"
		respond "{$DOMAIN}"
	}

	@api path /v1/* /health /.well-known/assetlinks.json /.well-known/apple-app-site-association
	handle @api {
		reverse_proxy api:8080
	}

	# Web app manifests carry the business name, colour and icons: the API renders them from the brand profile.
	handle /site.webmanifest {
		rewrite * /v1/brand/manifest/site
		reverse_proxy api:8080
	}
	handle /app/manifest.json {
		rewrite * /v1/brand/manifest/customer
		reverse_proxy api:8080
	}
	handle /admin/manifest.json {
		rewrite * /v1/brand/manifest/console
		reverse_proxy api:8080
	}

	# Browsers, feed readers and crawlers ask for these fixed addresses without reading the page: send them to the
	# brand icon the pages name (the owner's upload, or the built-in one). The template only sets Location.
	handle /favicon.ico {
		templates
		header Cache-Control "public, max-age=3600"
		respond `{{.RespHeader.Set "Location" (httpInclude "/v1/public/seller-info?field=favicon")}}` 302
	}
	@apple_icon path /apple-touch-icon.png /apple-touch-icon-precomposed.png
	handle @apple_icon {
		templates
		header Cache-Control "public, max-age=3600"
		respond `{{.RespHeader.Set "Location" (httpInclude "/v1/public/seller-info?field=apple_icon")}}` 302
	}

	# Public SEO pages and feeds are rendered by the API from live data (crates/api/src/seo.rs).
	@seo path /c/* /sitemap.xml /robots.txt /notices.xml
	handle @seo {
		reverse_proxy api:8080
	}
	# Search Console / Search Advisor HTML-file verification (googleTOKEN.html, naverTOKEN.html).
	@verify path_regexp verify ^/(google|naver)[A-Za-z0-9_-]+\.html$
	handle @verify {
		reverse_proxy api:8080
	}

	# Live progress of a server job: the root agent writes /srv/ops-progress/<token>.json (state only) and removes it
	# 10 minutes after the job ends. The 128-bit token is the only key; no listing, never cached.
	@ops_progress path_regexp ops_progress ^/ops-progress/([0-9a-f]{32})$
	handle @ops_progress {
		rewrite * /{re.ops_progress.1}.json
		root * /srv/ops-progress
		header Cache-Control "no-store"
		file_server
	}

	# Fallback fonts for both Flutter apps (Roboto + Noto, mirrored at image build; deploy/flutter_bootstrap.js
	# points the engine here). Paths carry Google's version and hash, so they never change: cache forever.
	# No try_files: a missing font must be a 404, not index.html.
	handle_path /webfonts/* {
		root * /srv/webfonts
		header Cache-Control "public, max-age=31536000, immutable"
		header Content-Type font/woff2
		file_server
	}

	# Flutter web output has no content hashes in its file names (main.dart.js, main.dart.wasm, canvaskit/,
	# assets/), so a cached copy can be older than the bootstrap that loads it and break the app after a
	# deploy. Everything revalidates (ETag -> 304 when unchanged); only /webfonts/ above is immutable.
	# The shell page (index.html) takes the business name and icons from the API with {{httpInclude}}. Only that page
	# is templated: other Flutter output (assets/NOTICES) can hold "{{" and must be served as it is.
	redir /admin /admin/
	handle_path /admin/* {
		root * /srv/console
		try_files {path} /index.html
		header Cache-Control "no-cache"
		@console_shell path / /index.html
		templates @console_shell
		file_server
	}

	redir /app /app/
	handle_path /app/* {
		root * /srv/app
		try_files {path} /index.html
		header Cache-Control "no-cache"
		@app_shell path / /index.html
		templates @app_shell
		file_server
	}

	# The 404 page only ever answers an unknown address; asked for by name it is a 404 too.
	@error_page path /404 /404.html
	handle @error_page {
		error 404
	}

	# Website file names carry no content hash, so assets are cached for an hour and pages revalidate.
	# A page is a file, name.html or a folder's index.html; any other address is a 404 (handle_errors below).
	handle {
		root * /srv/website
		@site_assets path /assets/* /vendor/*
		@site_pages not path /assets/* /vendor/*
		header @site_assets Cache-Control "public, max-age=3600"
		header @site_pages Cache-Control "no-cache"
		# Seller details (전자상거래법 제10조) are written into the HTML here, on the server: {{httpInclude}}
		# fetches the API fragment /v1/public/seller-info (backend routes/seller.rs). Only text/html is templated,
		# and pay/ and auth/ stay as they are. A failing fragment fails the page, so keep the API up.
		@site_templated not path /assets/* /vendor/* /pay/* /auth/*
		templates @site_templated
		try_files {path} {path}.html {path}/index.html
		file_server
	}

	# API down or restarting (502/503 from the proxy, or 500 when a page's httpInclude fragment cannot reach it):
	# pages get a static maintenance page, sent as 503, instead of a bare error. API paths keep their own status,
	# so the apps still get a JSON error they can read. /health stays a plain error so probes see the API as down.
	handle_errors {
		import edge-headers
		@page_down expression {http.error.status_code} in [500, 502, 503] && !{http.request.uri.path}.startsWith("/v1/") && !{http.request.uri.path}.startsWith("/health")
		handle @page_down {
			root * /srv/website
			rewrite * /maintenance.html
			header Cache-Control "no-store"
			file_server {
				status 503
			}
		}
		# Unknown address: the website's own 404 page, templated like the other pages and sent as 404. Files that
		# only programs fetch (fonts, job progress, assets) keep a bare 404; checked on the address as requested,
		# since handle_path and rewrite have changed the path by now.
		@page_missing expression `{http.error.status_code} == 404 && !{http.request.orig_uri.path}.matches("^/(webfonts|ops-progress|assets|vendor)/")`
		handle @page_missing {
			root * /srv/website
			rewrite * /404.html
			templates
			header Cache-Control "no-cache"
			file_server {
				status 404
			}
		}
	}
}

{$DOMAIN} {
	# TLS_MODE: see the tls- snippets above.
	import tls-{$TLS_MODE}
	import site
}

# www -> apex. HSTS above covers subdomains, so without this site a visitor typing www gets a TLS error.
# Without a www DNS record Caddy only logs failed certificate attempts for www; the main site is unaffected.
www.{$DOMAIN} {
	import tls-{$TLS_MODE}
	header -Server
	redir https://{$DOMAIN}{uri} permanent
}

# Former domains: any other host name, but a certificate only for the hosts the API lists (on_demand_tls above), so
# a stranger's DNS name pointed here gets no certificate. Website and SEO pages move to DOMAIN for search engines;
# the API, payment pages, app links, sign-in callbacks and the apps answer here as before, because installed apps do
# not follow redirects for POST, websockets or the payment done page.
https:// {
	import alias-tls-{$TLS_MODE}
	@old_pages not path /v1/* /health /.well-known/* /pay /pay/* /auth/* /app /app/* /admin /admin/* /robots.txt /webfonts/* /ops-progress/*
	# 301 for Google's Change of Address and Naver's 사이트 이전; no-store so browsers do not keep it for good, and a
	# rolled-back or repeated move cannot loop.
	header @old_pages Cache-Control "no-store"
	redir @old_pages https://{$DOMAIN}{uri} 301
	import site
}
